# ─────────────────────────────────────────────────────────────────────────────
# HustleClub — Environment Variables
# Copy to .env.local and fill in your values.
# NEVER commit .env.local — it is covered by .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (get from: supabase.com → project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_server_only_never_expose

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payments — "mock" for local dev | "razorpay" | "stripe"
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=any_random_string_for_local_dev
