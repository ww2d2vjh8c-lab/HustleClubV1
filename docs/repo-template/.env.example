# ─────────────────────────────────────────────────────────────────────────────
# Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — it is in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (get from: supabase.com → project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_keep_secret

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payments: "mock" for local dev, "razorpay" or "stripe" for production
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=any_random_string_for_local_dev
